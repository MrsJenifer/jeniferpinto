"use client";
import { adminFetch } from "@/lib/admin-fetch";
import { useCallback, useEffect, useMemo, useState } from "react";import { useSearchParams } from "next/navigation";import { contentTypes } from "@/lib/validation";import type { ContentItem, ContentType } from "@/lib/types";import { VersionHistory } from "./VersionHistory";import { Save, Plus, Trash2, Pencil, RefreshCw, Eye, EyeOff } from "lucide-react";
const labels:Record<ContentType,string>={profile:"Profile",project:"Finance project",skill:"Skill",experience:"Experience",education:"Education",certification:"Certification",achievement:"Achievement",article:"Article",testimonial:"Testimonial",site_settings:"Site settings"};
function slugify(s:string){return s.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").slice(0,120)}
function val(d:Record<string,unknown>,k:string){const v=d[k];return typeof v==="string"?v:""}
export function ContentManager(){const search=useSearchParams();const [type,setType]=useState<ContentType>((contentTypes.includes(search.get("type") as ContentType)?search.get("type"):"project") as ContentType);const [items,setItems]=useState<ContentItem[]>([]);const [selected,setSelected]=useState<ContentItem|null>(null);const [title,setTitle]=useState("");const [slug,setSlug]=useState("");const [summary,setSummary]=useState("");const [description,setDescription]=useState("");const [category,setCategory]=useState("");const [tools,setTools]=useState("");const [published,setPublished]=useState(false);const [sortOrder,setSortOrder]=useState(0);const [featured,setFeatured]=useState(false);const [extra,setExtra]=useState("{}");const [loading,setLoading]=useState(true);const [busy,setBusy]=useState(false);const [notice,setNotice]=useState("");const [bad,setBad]=useState(false);const [query,setQuery]=useState("");const [jsonMode,setJsonMode]=useState(false);const [siteTitle,setSiteTitle]=useState("");const [siteDescription,setSiteDescription]=useState("");const [heroTitle,setHeroTitle]=useState("");const [selectedTitle,setSelectedTitle]=useState("");const [selectedIntro,setSelectedIntro]=useState("");const [aboutTitle,setAboutTitle]=useState("");const [skillsTitle,setSkillsTitle]=useState("");const [stepsTitle,setStepsTitle]=useState("");const [ctaTitle,setCtaTitle]=useState("");const [footerTagline,setFooterTagline]=useState("");
const load = useCallback(async (t: ContentType = type) => {
  try {
    const res = await adminFetch(`/api/admin/content?type=${encodeURIComponent(t)}`, { cache: "no-store" });
    const body = await res.json();
    if (!res.ok) throw new Error(body.error || "Could not load content.");
    setItems(body.items || []);
    setBad(false);
  } catch (error) {
    setBad(true);
    setNotice(error instanceof Error ? error.message : "Could not load content.");
  } finally {
    setLoading(false);
  }
}, [type]);
// Intentional async data-fetching effect; state updates occur after the network request.
// eslint-disable-next-line react-hooks/set-state-in-effect
useEffect(() => { void load(type); }, [load, type]);
function clear(){setSelected(null);setTitle("");setSlug("");setSummary("");setDescription("");setCategory("");setTools("");setPublished(false);setSortOrder(items.length);setFeatured(false);setExtra("{}");setJsonMode(false);setSiteTitle("");setSiteDescription("");setHeroTitle("");setSelectedTitle("");setSelectedIntro("");setAboutTitle("");setSkillsTitle("");setStepsTitle("");setCtaTitle("");setFooterTagline("");setNotice("");setBad(false)}
function edit(i:ContentItem){const d=i.data||{};setSelected(i);setTitle(val(d,"title")||val(d,"name")||val(d,"degree")||val(d,"headline"));setSlug(i.slug);setSummary(val(d,"summary")||val(d,"intro"));setDescription(val(d,"description")||val(d,"bio"));setCategory(val(d,"category")||val(d,"specialisation"));setTools(Array.isArray(d.tools)?d.tools.join(", "):"");setPublished(i.is_published);setSortOrder(i.sort_order);setFeatured(Boolean(d.featured));const known=["title","name","degree","summary","intro","description","bio","category","specialisation","tools","featured"];const rest=Object.fromEntries(Object.entries(d).filter(([k])=>!known.includes(k)));setExtra(JSON.stringify(rest,null,2));setSiteTitle(val(d,"site_title"));setSiteDescription(val(d,"site_description"));setHeroTitle(val(d,"home_hero_title"));setSelectedTitle(val(d,"home_selected_title"));setSelectedIntro(val(d,"home_selected_intro"));setAboutTitle(val(d,"home_about_title"));setSkillsTitle(val(d,"home_skills_title"));setStepsTitle(val(d,"home_steps_title"));setCtaTitle(val(d,"home_cta_title"));setFooterTagline(val(d,"footer_tagline"));setJsonMode(false);setNotice("");setBad(false)}
function buildData(){let rest:Record<string,unknown>;try{rest=JSON.parse(extra||"{}");if(!rest||Array.isArray(rest)||typeof rest!=="object")throw new Error("Additional data must be a JSON object.");}catch(e){throw new Error(e instanceof Error?e.message:"Additional data must be valid JSON.")}const base:Record<string,unknown>={...rest};const primary=type==="profile"?"name":type==="education"?"degree":type==="skill"?"name":"title";if(title.trim())base[primary]=title.trim();if(summary.trim())base[type==="profile"?"intro":"summary"]=summary.trim();if(description.trim())base.description=description.trim();if(category.trim())base[type==="education"?"specialisation":"category"]=category.trim();if(type==="project")base.tools=tools.split(",").map(s=>s.trim()).filter(Boolean);if(type==="project")base.featured=featured;if(type==="site_settings"){Object.assign(base,{site_title:siteTitle.trim(),site_description:siteDescription.trim(),home_hero_title:heroTitle.trim(),home_selected_title:selectedTitle.trim(),home_selected_intro:selectedIntro.trim(),home_about_title:aboutTitle.trim(),home_skills_title:skillsTitle.trim(),home_steps_title:stepsTitle.trim(),home_cta_title:ctaTitle.trim(),footer_tagline:footerTagline.trim()});}return base;}
async function save(e:React.FormEvent){e.preventDefault();setBusy(true);setNotice("");setBad(false);try{const data=buildData();const finalSlug=slugify(slug||title||type);if(!finalSlug)throw new Error("A slug is required.");const payload={...(selected?{id:selected.id}:{}),content_type:type,slug:finalSlug,data,is_published:published,sort_order:sortOrder};const r=await adminFetch("/api/admin/content",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});const b=await r.json();if(!r.ok)throw new Error(b.error||"Could not save item.");setNotice("Content saved successfully.");setLoading(true);await load(type);if(b.item)edit(b.item); }catch(e){setBad(true);setNotice(e instanceof Error?e.message:"Could not save content.");}finally{setBusy(false)}}
async function remove(i:ContentItem){if(!confirm(`Delete “${val(i.data,"title")||val(i.data,"name")||i.slug}”? This cannot be undone.`))return;try{const r=await adminFetch(`/api/admin/content?id=${encodeURIComponent(i.id)}`,{method:"DELETE"});const b=await r.json();if(!r.ok)throw new Error(b.error||"Could not delete item.");if(selected?.id===i.id)clear();setNotice("Content deleted.");setLoading(true);await load(type);}catch(e){setBad(true);setNotice(e instanceof Error?e.message:"Could not delete item.")}}
const filtered=useMemo(()=>items.filter(i=>`${i.slug} ${JSON.stringify(i.data)}`.toLowerCase().includes(query.toLowerCase())),[items,query]);return <><h1>Content management</h1><p className="subtitle">Edit, publish, and maintain the content shown on the public website.</p>{notice&&<div className={`admin-alert${bad?" error":""}`} role="status">{notice}</div>}<section className="admin-panel"><div className="admin-panel-head"><h2>Content collection</h2><button className="btn btn-outline" onClick={()=>{setLoading(true);setNotice("");setBad(false);void load();}}><RefreshCw size={14}/> Refresh</button></div><div className="admin-toolbar"><select value={type} onChange={e=>{clear();setLoading(true);setType(e.target.value as ContentType)}} aria-label="Content type">{contentTypes.map(t=><option key={t} value={t}>{labels[t]}</option>)}</select><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search content…" aria-label="Search content"/><button className="btn btn-primary" onClick={clear}><Plus size={14}/> New {labels[type].toLowerCase()}</button></div><div className="admin-table-wrap" style={{marginTop:15}}>{loading?<p className="small-muted">Loading content…</p>:filtered.length?<table className="admin-table"><thead><tr><th>Content</th><th>Slug</th><th>Status</th><th>Actions</th></tr></thead><tbody>{filtered.map(i=><tr key={i.id}><td><strong>{val(i.data,"title")||val(i.data,"name")||val(i.data,"degree")||val(i.data,"headline")||i.slug}</strong><small>{val(i.data,"summary")||val(i.data,"description")||labels[i.content_type]}</small></td><td>{i.slug}</td><td><span className={`pill${i.is_published?"":" draft"}`}>{i.is_published?"Published":"Draft"}</span></td><td><div style={{display:"flex",gap:7}}><button className="btn btn-outline" style={{padding:"6px 8px"}} onClick={()=>edit(i)} aria-label="Edit"><Pencil size={13}/></button><button className="btn btn-outline" style={{padding:"6px 8px"}} onClick={()=>remove(i)} aria-label="Delete"><Trash2 size={13}/></button></div></td></tr>)}</tbody></table>:<div className="empty-state">No records found. Create a new item or adjust the search.</div>}</div></section><VersionHistory key={selected?.id ?? "new"} itemId={selected?.id??null} onRestored={(item)=>{edit(item);setNotice("Previous version restored.");setBad(false);void load(type);}}/><section className="admin-panel"><div className="admin-panel-head"><h2>{selected?"Edit content":"Create content"}</h2><button className="btn btn-outline" onClick={()=>setJsonMode(v=>!v)}>{jsonMode?"Structured editor":"Additional JSON fields"}</button></div><form onSubmit={save}><div className="form-grid"><div className="field"><label htmlFor="title">{type==="profile"||type==="skill"?"Name":"Title"}</label><input id="title" value={title} onChange={e=>{setTitle(e.target.value);if(!selected)setSlug(slugify(e.target.value));}} placeholder={type==="profile"?"Jenifer Pinto":"Content title"} required/></div><div className="field"><label htmlFor="slug">URL slug</label><input id="slug" value={slug} onChange={e=>setSlug(slugify(e.target.value))} required maxLength={120}/></div><div className="field"><label htmlFor="sort-order">Display order</label><input id="sort-order" type="number" min="0" max="100000" value={sortOrder} onChange={e=>setSortOrder(Math.max(0,Math.min(100000,Number(e.target.value)||0)))}/><span className="small-muted">Lower numbers appear first within the section.</span></div><div className="field field-full"><label htmlFor="summary">{type==="profile"?"Professional introduction":"Summary / short description"}</label><textarea id="summary" value={summary} onChange={e=>setSummary(e.target.value)} rows={3}/></div><div className="field field-full"><label htmlFor="description">Long description / methodology</label><textarea id="description" value={description} onChange={e=>setDescription(e.target.value)} rows={4}/></div>{type!=="profile"&&<div className="field"><label htmlFor="category">Category / specialisation</label><input id="category" value={category} onChange={e=>setCategory(e.target.value)}/></div>}{type==="project"&&<div className="field"><label htmlFor="tools">Tools (comma-separated)</label><input id="tools" value={tools} onChange={e=>setTools(e.target.value)} placeholder="Excel, Power BI, Financial Modelling"/></div>}{type==="site_settings"&&<><div className="field field-full"><label htmlFor="site-title">Browser / SEO title</label><input id="site-title" value={siteTitle} onChange={e=>setSiteTitle(e.target.value)} maxLength={160}/></div><div className="field field-full"><label htmlFor="site-description">SEO description</label><textarea id="site-description" value={siteDescription} onChange={e=>setSiteDescription(e.target.value)} rows={2} maxLength={320}/></div><div className="field field-full"><label htmlFor="hero-title">Homepage hero heading</label><input id="hero-title" value={heroTitle} onChange={e=>setHeroTitle(e.target.value)} maxLength={180}/></div><div className="field"><label htmlFor="selected-title">Featured projects heading</label><input id="selected-title" value={selectedTitle} onChange={e=>setSelectedTitle(e.target.value)}/></div><div className="field"><label htmlFor="about-title">About section heading</label><input id="about-title" value={aboutTitle} onChange={e=>setAboutTitle(e.target.value)}/></div><div className="field field-full"><label htmlFor="selected-intro">Featured projects introduction</label><textarea id="selected-intro" value={selectedIntro} onChange={e=>setSelectedIntro(e.target.value)} rows={2}/></div><div className="field"><label htmlFor="skills-title">Skills section heading</label><input id="skills-title" value={skillsTitle} onChange={e=>setSkillsTitle(e.target.value)}/></div><div className="field"><label htmlFor="steps-title">Process section heading</label><input id="steps-title" value={stepsTitle} onChange={e=>setStepsTitle(e.target.value)}/></div><div className="field"><label htmlFor="cta-title">Closing CTA heading</label><input id="cta-title" value={ctaTitle} onChange={e=>setCtaTitle(e.target.value)}/></div><div className="field"><label htmlFor="footer-tagline">Footer tagline</label><input id="footer-tagline" value={footerTagline} onChange={e=>setFooterTagline(e.target.value)}/></div></>}{jsonMode&&<div className="field field-full"><label htmlFor="extra">Additional data (JSON object)</label><textarea className="json-editor" id="extra" value={extra} onChange={e=>setExtra(e.target.value)} rows={10} spellCheck={false}/><span className="small-muted">Advanced fields retain links, experience dates, certification information, deliverables, and other section-specific data.</span></div>}</div><div style={{display:"flex",gap:18,flexWrap:"wrap",margin:"6px 0 20px"}}><label style={{fontSize:12,display:"flex",gap:8,alignItems:"center"}}><input type="checkbox" checked={published} onChange={e=>setPublished(e.target.checked)}/><span>{published?<><Eye size={13} style={{display:"inline"}}/> Publish publicly</>:<><EyeOff size={13} style={{display:"inline"}}/> Keep as draft</>}</span></label>{type==="project"&&<label style={{fontSize:12,display:"flex",gap:8,alignItems:"center"}}><input type="checkbox" checked={featured} onChange={e=>setFeatured(e.target.checked)}/> Feature on homepage</label>}</div><div className="admin-toolbar"><button className="btn btn-primary" disabled={busy}><Save size={14}/>{busy?"Saving…":"Save content"}</button><button type="button" className="btn btn-outline" onClick={clear}>Clear form</button></div></form></section><p className="small-muted">Content actions are validated server-side. Publishing makes the record available to public pages; review personal information and document permissions before publishing.</p></>}
