"use client";
import Link from "next/link";
import { usePathname, useSearchParams } from "next/navigation";
import { LayoutDashboard, FolderKanban, Image as ImageIcon, Settings, UserRound, ExternalLink, GraduationCap, Wrench, Mail, Award, BriefcaseBusiness, Menu } from "lucide-react";
import { LogoutButton } from "./LogoutButton";
import styles from "./AdminShell.module.css";

const nav = [
  { href: "/admin", label: "Overview", icon: LayoutDashboard, exact: true },
  { href: "/admin/content?type=profile", activePath: "/admin/content", type: "profile", label: "Profile", icon: UserRound },
  { href: "/admin/content?type=project", activePath: "/admin/content", type: "project", label: "Finance projects", icon: FolderKanban },
  { href: "/admin/content?type=experience", activePath: "/admin/content", type: "experience", label: "Experience", icon: BriefcaseBusiness },
  { href: "/admin/content?type=education", activePath: "/admin/content", type: "education", label: "Education", icon: GraduationCap },
  { href: "/admin/content?type=skill", activePath: "/admin/content", type: "skill", label: "Skills", icon: Wrench },
  { href: "/admin/content?type=certification", activePath: "/admin/content", type: "certification", label: "Certifications", icon: Award },
  { href: "/admin/content", activePath: "/admin/content", type: "all", label: "All content", icon: Settings },
  { href: "/admin/media", label: "Media & Drive", icon: ImageIcon },
  { href: "/admin/enquiries", label: "Enquiries", icon: Mail },
];

export function AdminShell({ children, email, role }: { children: React.ReactNode; email: string; role: string }) {
  const pathname = usePathname();
  const search = useSearchParams();
  const contentType = search.get("type") || "all";
  return <div className={styles.shell}>
    <aside className={styles.sidebar}>
      <Link href="/admin" className={styles.brand} aria-label="Jenifer Finance admin home">
        <span className={styles.brandMark}>JP</span><span><strong>Jenifer Pinto</strong><small>PORTFOLIO STUDIO</small></span>
      </Link>
      <div className={styles.navCaption}>WORKSPACE</div>
      <nav className={styles.nav} aria-label="Admin navigation">
        {nav.map(({ href, label, icon: Icon, exact, activePath }) => {
          const active = exact
            ? pathname === href
            : activePath === "/admin/content"
              ? pathname === "/admin/content" && contentType === (nav.find(n => n.label === label)?.type || "all")
              : pathname === href || Boolean(activePath && pathname.startsWith(activePath + "/"));
          return <a key={label} href={href} className={`${styles.navLink} ${active ? styles.active : ""}`} aria-current={active ? "page" : undefined}>
            <Icon size={17} strokeWidth={1.8} /><span>{label}</span>{active && <span className={styles.activeDot} />}
          </a>;
        })}
      </nav>
      <div className={styles.sidebarBottom}>
        <div className={styles.secure}><span className={styles.secureDot} />Secure workspace <span className={styles.role}>{role}</span></div>
        <Link href="/" target="_blank" rel="noopener noreferrer" className={styles.viewSite}><ExternalLink size={15}/> View live website</Link>
      </div>
    </aside>
    <div className={styles.main}>
      <header className={styles.topbar}>
        <div className={styles.mobileBrand}><Menu size={17}/> <strong>Portfolio Studio</strong></div>
        <div className={styles.breadcrumb}><span>Workspace</span><span className={styles.crumbSlash}>/</span><strong>{nav.find(n => n.exact ? pathname === n.href : pathname.startsWith(n.activePath || n.href))?.label || "Admin"}</strong></div>
        <div className={styles.account}><span className={styles.avatar}>{(email || "A").slice(0,1).toUpperCase()}</span><span className={styles.email}>{email}</span><LogoutButton/></div>
      </header>
      <main className={styles.content}>{children}</main>
      <footer className={styles.footer}>Portfolio Studio <span>â€¢</span> Changes are saved to your portfolio database when you save an item.</footer>
    </div>
  </div>;
}

