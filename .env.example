# Public Supabase project settings (the publishable key is safe for browser use when RLS is correctly configured)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional operational settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_TO_EMAIL=

# Google Drive OAuth is optional. Configure only after the core app works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Server-only key for the contact API and atomic rate limiter. NEVER prefix with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
