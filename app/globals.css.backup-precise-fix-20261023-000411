.admin-brand,.admin-nav,.admin-sidebar>div{position:relative;z-index:1}.admin-nav a{transition:background .2s,color .2s,transform .2s}.admin-nav a:hover{transform:translateX(3px)}
.admin-topbar{position:sticky;top:0;z-index:20;backdrop-filter:blur(16px);background:rgba(255,255,255,.9)}
.admin-content>h1{letter-spacing:-.035em;font-size:clamp(25px,3vw,34px)}.admin-content .subtitle{font-size:13px;line-height:1.75}
.admin-panel,.metric-card{box-shadow:0 5px 20px rgba(16,35,63,.025)}.admin-panel:hover{border-color:#d7dfe8}
.field input,.field textarea,.field select,.json-editor,.inline-form input,.inline-form select{transition:border-color .2s,box-shadow .2s,background .2s}.field input:focus,.field textarea:focus,.field select:focus,.json-editor:focus{border-color:#a88b53;box-shadow:0 0 0 4px rgba(198,164,101,.13);outline:none}
.admin-alert{animation:fade-up .3s var(--motion-ease) both}.pill{font-weight:750;letter-spacing:.015em}
@keyframes fade-up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes gradient-text{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
@keyframes aurora-drift{0%{transform:translate3d(-2%,0,0) scale(.95)}100%{transform:translate3d(3%,5%,0) scale(1.08)}}
@keyframes float-card{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
@keyframes panel-sheen{0%,72%,100%{transform:translateX(-110%)}85%{transform:translateX(110%)}}
@keyframes slow-spin{to{transform:rotate(360deg)}}
@media(max-width:720px){.hero:before{width:115vw;height:115vw;right:-45%;top:-10%}.profile-card{animation:none}.admin-topbar{position:relative}.hero h1{background-size:150% 100%}}
@media(prefers-reduced-motion:reduce){.hero h1,.hero .eyebrow,.hero-copy,.hero-ctas,.hero-note,.profile-card,.hero:before,.about-panel:before,.cta-band:before{animation:none!important}.hero h1{color:var(--navy);background:none;-webkit-text-fill-color:currentColor}.project-card,.skill-card,.step-card,.metric-card,.media-card,.btn,.admin-nav a{transition:none!important}}

